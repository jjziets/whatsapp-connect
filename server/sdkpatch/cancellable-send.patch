+// LockContext preserves the caller's existing lock/unlock semantics without a
+// lock goroutine. Cancellation observed after acquisition releases the lock.
+func LockContext(ctx context.Context, tryLock func() bool, unlock func()) error {
+	var timer *time.Timer
+	defer func() {
+		if timer != nil {
+			timer.Stop()
+		}
+	}()
+	for {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if tryLock() {
+			if err := ctx.Err(); err != nil {
+				unlock()
+				return err
+			}
+			return nil
+		}
+		if timer == nil {
+			timer = time.NewTimer(2 * time.Millisecond)
+		} else {
+			timer.Reset(2 * time.Millisecond)
+		}
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-timer.C:
+		}
+	}
+}
